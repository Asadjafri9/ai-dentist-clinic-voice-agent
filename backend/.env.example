APP_ENV=development
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:3000

MONGODB_URI=
MONGODB_DATABASE=ai_dentist_voice_agent

AUTH_COOKIE_NAME=ai_voice_session
AUTH_SESSION_TTL_HOURS=24
AUTH_CSRF_SECRET=

VAPI_API_KEY=
VAPI_SERVER_CREDENTIAL_MODE=hmac
VAPI_SERVER_CREDENTIAL_SECRET=
VAPI_SERVER_CREDENTIAL_HEADER=x-signature
VAPI_SERVER_TIMESTAMP_HEADER=x-timestamp
VAPI_MAX_REPLAY_SKEW_SECONDS=300
VAPI_TOOL_TIMEOUT_SECONDS=4

OFFER_TOKEN_SECRET=
OFFER_TOKEN_TTL_SECONDS=300
BOOKING_HORIZON_DAYS=90

TRANSCRIPT_RETENTION_DAYS=30
LOG_LEVEL=INFO

# Demo seeding only (never used in production)
SEED_ADMIN_EMAIL=admin@brightsmile.test
SEED_ADMIN_PASSWORD=
